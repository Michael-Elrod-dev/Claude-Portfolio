# Non-secret settings, installed by deploy as /etc/claude-portfolio/claude-portfolio.env
# (root:claude-portfolio 0640). API keys and the bearer token live in secrets.env beside
# it, the Firebase key in fcm-sa.json, and the backup key in aws.env.
PORTFOLIO_DATA_DIR=/srv/claude-portfolio
PORTFOLIO_API_SOCKET=/run/caddy-upstreams/claude-portfolio/site.sock
FCM_SERVICE_ACCOUNT_FILE=/etc/claude-portfolio/fcm-sa.json
CONGRESSIONAL_DATA_DIR=/srv/claude-portfolio/congressional
DATABASE_URL=sqlite:////srv/claude-portfolio/congressional/congressional.db
PORTFOLIO_BACKUP_BUCKET=claude-portfolio-backup-b1422366
NODE_ENV=production
