[Unit]
Description=Congressional disclosures, the evening before each trading run

[Timer]
OnCalendar=Sun,Wed *-*-* 20:00:00 America/New_York
RandomizedDelaySec=5min
# Catch up after the laptop was off; the snapshot only has to be fresher than the next run.
Persistent=true

[Install]
WantedBy=timers.target
