ALPACA_KEY_ID=your_paper_trading_key_id
ALPACA_SECRET_KEY=your_paper_trading_secret_key
FINNHUB_API_KEY=your_finnhub_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional: S3 location of the persistent memo (production).
# If unset, the local file at MEMO_LOCAL_PATH (default ./memo.json) is used.
# AWS credentials come from the standard SDK chain (no keys in .env).
MEMO_S3_BUCKET=
MEMO_S3_KEY=memo.json
AWS_REGION=us-east-1
