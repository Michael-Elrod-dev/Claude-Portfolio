# Local development only. On the laptop these come from
# /etc/claude-portfolio/secrets.env through the systemd units.
ALPACA_KEY_ID=your_live_key_id
ALPACA_SECRET_KEY=your_live_secret_key
FINNHUB_API_KEY=your_finnhub_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Where the memo, runs, activity and congressional snapshot live.
# Defaults to ./data next to package.json.
PORTFOLIO_DATA_DIR=
