{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3MemoAndQueued",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:HeadObject"
      ],
      "Resource": "arn:aws:s3:::claude-portfolio-369382711663/*"
    },
    {
      "Sid": "S3ListBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::claude-portfolio-369382711663"
    },
    {
      "Sid": "SecretsManager",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:us-east-1:369382711663:secret:claude-portfolio/*"
    },
    {
      "Sid": "SSMFlags",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:PutParameter"
      ],
      "Resource": "arn:aws:ssm:us-east-1:369382711663:parameter/claude-portfolio-*"
    },
    {
      "Sid": "SESNotifications",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:SendRawEmail"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DynamoRunsActivityDevices",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:BatchWriteItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:369382711663:table/claude-portfolio-runs",
        "arn:aws:dynamodb:us-east-1:369382711663:table/claude-portfolio-activity",
        "arn:aws:dynamodb:us-east-1:369382711663:table/claude-portfolio-devices"
      ]
    }
  ]
}
