# Android-specific ignores layered on top of the root .gitignore. Most
# patterns here are also in the root file; duplicating them keeps this
# folder usable in isolation if you ever extract it.

# Gradle / build
*.iml
.gradle/
.kotlin/
local.properties
build/
captures/
.externalNativeBuild/
.cxx/

# Gradle wrapper jar — Studio regenerates on first sync.
gradle/wrapper/gradle-wrapper.jar

# Android Studio
.idea/
*.iws
*.ipr

# Keystore files (release signing). We don't ship a release build today,
# but if you ever generate one, the keystore goes in the repo root and
# stays out of git via these patterns.
*.jks
*.keystore

# Profiling output
*.hprof

# Firebase Android client config. The file itself isn't a secret per
# Firebase's docs (it's designed to ship inside client APKs), but on a
# public repo it triggers GitHub's secret scanner and lets bots probe
# the project. Each developer downloads their own copy from
# Firebase Console → Project Settings → Your apps → Android app
# and drops it into android/app/. See android/README.md for the full
# setup walkthrough.
app/google-services.json
