<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns all theming at runtime. The XML theme only exists so the
         splash, status bar and navigation bar land on Kiln's surfaces before
         the first frame. Status bar matches the app surface behind the app
         bar; navigation bar matches the chrome surface behind the bottom nav. -->
    <style name="Theme.ClaudePortfolio" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/kiln_surface_app</item>
        <item name="android:navigationBarColor">@color/kiln_surface_chrome</item>
        <item name="android:windowBackground">@color/kiln_surface_app</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
